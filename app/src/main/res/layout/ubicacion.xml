<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textAlignment="center">

    <!-- Contenido principal -->
    <FrameLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

        <!-- Logo -->
        <TextView
            android:id="@+id/logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:text="KöVa"
            android:textColor="@color/icono_normal"
            android:textSize="32sp" />

        <!-- Título -->
        <TextView
            android:id="@+id/titulo"
            style="@style/Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="110dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/titulo_ubicacion"
            android:textColor="@color/icono_normal"
            android:textSize="20sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/logo" />

        <!-- Descripcion -->
        <TextView
            android:id="@+id/descripcion"
            style="@style/DescripciónActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="143dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:fontFamily="@font/roboto_regular"
            android:text="@string/descripcion_ubicacion"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/titulo"
            app:layout_constraintTop_toBottomOf="@+id/titulo" />

        <!-- Mapa -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="352dp"
            android:layout_height="564dp"
            android:layout_marginTop="203dp"
            android:layout_marginStart="30dp"/>
    </FrameLayout>

    <!-- Desplegable hacia arriba -->
    <LinearLayout
        android:id="@+id/panel_desplegable"
        android:layout_width="match_parent"
        android:layout_height="131dp"
        android:background="@drawable/desplegable_navbar"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:layout_marginBottom="12dp"
            android:background="@color/boton_oscuro" />

    </LinearLayout>

    <!-- Nav bar -->
    <include
        layout="@layout/navbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:layout_anchorGravity="bottom" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
