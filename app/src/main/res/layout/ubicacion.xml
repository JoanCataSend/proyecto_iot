<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:textAlignment="center">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- TÍTULO -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/titleSeguridad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Informacion de tus coches"
                android:textColor="@color/icono_normal"
                android:textSize="20sp"
                android:fontFamily="@font/roboto_medium"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- DESCRIPCIÓN -->
        <TextView
            android:id="@+id/descripcion"
            style="@style/DescripciónActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:layout_marginTop="10dp"
            android:fontFamily="@font/roboto_regular"
            android:text="@string/descripcion_ubicacion"
            android:textColor="@color/icono_normal" />

        <!-- MAPA -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/map"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="570dp"
            android:layout_marginStart="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="40dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- PANEL DESPLEGABLE -->
    <LinearLayout
        android:id="@+id/panel_desplegable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/desplegable_navbar"
        android:orientation="vertical"
        android:paddingLeft="30dp"
        android:paddingRight="30dp"
        android:paddingBottom="0dp"
        android:maxHeight="460dp"
        android:translationY="5dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <View
            android:layout_width="95dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:layout_marginTop="15dp"
            android:background="@color/boton_oscuro" />

        <!-- TÍTULO PANEL -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/titleSeguridad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Mis coches registrados"
                android:textColor="@color/icono_normal"
                android:textSize="20sp"
                android:fontFamily="@font/roboto_medium"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- DESCRIPCIÓN PANEL -->
        <TextView
            android:id="@+id/panel_descrip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/descripcion_mis_coches"
            android:textColor="@color/icono_normal"
            style="@style/DescripciónActividad"
            android:layout_marginTop="8dp" />

        <!-- LISTA DE COCHES (RECYCLER) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerCoches"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="10dp"
            android:layout_weight="1"
            android:overScrollMode="never"/>

        <!-- BOTÓN AÑADIR COCHE -->
        <LinearLayout
            android:id="@+id/btnAnadirCoche"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_boton_anadir_coche"
            android:padding="10dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_mas"
                app:tint="@color/boton_oscuro"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Añadir nuevo coche"
                android:textColor="@color/boton_oscuro"
                android:textSize="15sp"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/montserrat_bold"/>
        </LinearLayout>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
