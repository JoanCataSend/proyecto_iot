<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_claro"
    tools:context=".MainActivity">

    <!-- 🟦 CONTENEDOR PARA MOSTRAR FRAGMENTS -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- 🟧 CONTENIDO PRINCIPAL -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="24dp"
        android:paddingBottom="60dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- TÍTULO SELECTOR -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona el coche:"
                android:textColor="#505050"
                android:textSize="16sp"
                android:layout_marginBottom="7dp" />

            <!-- SELECTOR VEHÍCULO -->
            <LinearLayout
                android:id="@+id/vehicleSelector"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_coche_fino"
                    app:tint="@color/icono_normal" />

                <Spinner
                    android:id="@+id/spinnerCars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:popupBackground="@android:color/white" />

                <ImageView
                    android:id="@+id/ivArrow"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_flecha_abajo"
                    app:tint="@color/icono_normal" />
            </LinearLayout>

            <!-- IMAGEN DEL COCHE -->
            <ImageView
                android:id="@+id/ivCar"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:padding="6dp"
                android:src="@drawable/coche_julia" />

            <!-- ACCIONES -->
            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- CANDADO -->
                <LinearLayout
                    android:id="@+id/layoutLock"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="false"
                    android:focusable="false"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:id="@+id/flLock"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        android:clickable="true"
                        android:focusable="true"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivLock"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:src="@drawable/ic_candado_abierto"
                            app:tint="@color/texto_oscuro" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLockState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/bloqueado"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- CÁMARAS -->
                <LinearLayout
                    android:id="@+id/layoutCamaras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivCameras"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:src="@drawable/ic_camara"
                            app:tint="@color/texto_oscuro" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/camara_activada"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- SEÑALES -->
                <LinearLayout
                    android:id="@+id/layoutSignals"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:id="@+id/flSignals"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivSignals"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:src="@drawable/ic_sonido"
                            app:tint="@color/texto_oscuro" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/senales"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- SEGURO -->
                <LinearLayout
                    android:id="@+id/layoutSafeMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivSafe"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:src="@drawable/ic_escudo"
                            app:tint="@color/texto_oscuro" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvSafeState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/modo_seguro_activado"
                        android:textColor="@color/texto_oscuro"
                        android:textSize="14sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- NUEVO TÍTULO UBICACIÓN -->
            <TextView
                android:id="@+id/tvAddressTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Su coche se encuentra en:"
                android:textColor="#505050"
                android:textSize="16sp"
                android:layout_marginBottom="7dp"/>

            <!-- UBICACIÓN (PILL) -->
            <LinearLayout
                android:id="@+id/addressPill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="14dp"
                android:background="@drawable/bg_pill_soft"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_ubicacion"
                    app:tint="@color/icono_normal" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="Ubicación registrada"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_flecha_derecha"
                    app:tint="@color/icono_normal" />
            </LinearLayout>

            <!-- INFORMACIÓN SISTEMA -->
            <LinearLayout
                android:id="@+id/systemState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp"
                android:padding="16dp"
                android:background="@drawable/bg_card_soft"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más información del sistema:"
                    android:textColor="@color/texto_oscuro"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D3D3D3"
                    android:layout_marginBottom="20dp" />

                <View
                    android:id="@+id/viewSystemDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/bg_dot_ok" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="26dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wifi"
                        app:tint="@color/icono_normal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvSystemStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sistema activo y vigilando"
                            android:textStyle="bold"
                            android:textColor="@color/texto_oscuro"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvLastUpdate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Última conexión hace 2 minutos"
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- TIEMPO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="5dp">

                    <ImageView
                        android:id="@+id/ivWeather"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tiempo"
                        app:tint="@color/icono_normal" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:id="@+id/tvWeatherTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiempo: --"
                            android:textStyle="bold"
                            android:textColor="@color/texto_oscuro"
                            android:textSize="16sp" />

                        <TextView
                            android:id="@+id/tvWeatherDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando información meteorológica"
                            android:textColor="#7A7A7A"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>



            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
