<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:padding="24dp"
        android:paddingBottom="80dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?android:attr/colorBackground">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona el coche:"
                android:textColor="?attr/android:textColor"
                android:textSize="16sp"
                android:layout_marginBottom="7dp" />

            <!-- SELECTOR VEHÍCULO -->
            <LinearLayout
                android:id="@+id/vehicleSelector"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_soft"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/nombre_coche"
                    android:src="@drawable/ic_coche_fino"
                    app:tint="?attr/colorSecondary" />

                <Spinner
                    android:id="@+id/spinnerCars"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:popupBackground="@android:color/white" />

                <ImageView
                    android:id="@+id/ivArrow"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_flecha_abajo"
                    android:contentDescription="@string/titulo_ubicacion"
                    app:tint="?attr/colorSecondary" />
            </LinearLayout>

            <!-- IMAGEN DEL COCHE SIN CAJA ALREDEDOR -->
            <ImageView
                android:id="@+id/ivCar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/nombre_coche"
                android:padding="1dp"
                android:layout_marginBottom="16dp"
                android:scaleType="fitCenter"
                android:src="@drawable/coche_mat" />

            <LinearLayout
                android:id="@+id/actionsRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- 🔹 COLUMNA CANDADO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:id="@+id/flLock"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivLock"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/bloqueado"
                            android:padding="16dp"
                            android:src="@drawable/ic_candado_abierto"
                             />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvLockState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/bloqueado"
                        android:textColor="?attr/android:textColor"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 🔹 COLUMNA CÁMARAS -->
                <LinearLayout
                    android:id="@+id/layoutCamaras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        app:tint="?attr/android:colorPrimary"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivCameras"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/camara_activada"
                            android:padding="16dp"
                            android:src="@drawable/ic_camara"
                             />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/camara_activada"
                        android:textColor="?attr/android:textColor"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 🔹 COLUMNA SEÑALES -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        app:tint="?attr/android:colorPrimary"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivSignals"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/senales"
                            android:padding="16dp"
                            android:src="@drawable/ic_sonido"
                             />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/senales"
                        android:textColor="?attr/android:textColor"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- 🔹 COLUMNA MODO SEGURO -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackgroundBorderless">

                    <FrameLayout
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/bg_card_soft"
                        android:clipToOutline="true"
                        app:tint="?attr/android:colorPrimary"
                        android:elevation="4dp">

                        <ImageView
                            android:id="@+id/ivSafe"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/modo_seguro_activado"
                            android:padding="16dp"
                            android:src="@drawable/ic_escudo"
                             />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/modo_seguro_activado"
                        android:textColor="?attr/android:textColor"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/addressPill"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:background="@drawable/bg_pill_soft"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="25dp"
                    android:layout_height="25dp"
                    android:src="@drawable/ic_ubicacion"
                    android:contentDescription="@string/titulo_ubicacion"
                    app:tint="?attr/colorSecondary" />

                <TextView
                    android:id="@+id/tvAddress"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/calle"
                    android:textColor="?attr/android:textColor"
                    android:textSize="15dp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:src="@drawable/ic_flecha_derecha"
                    android:contentDescription="@string/titulo_ubicacion"
                    app:tint="?attr/colorSecondary" />
            </LinearLayout>

            <!--  SECCIÓN ESTADO DEL SISTEMA -->
            <LinearLayout
                android:id="@+id/systemState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="100dp"
                android:padding="16dp"
                android:background="@drawable/bg_card_soft"
                android:elevation="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Más información del sistema:"
                    android:textColor="?attr/android:textColor"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#D3D3D3"
                    android:layout_marginBottom="20dp" />

                <!-- FILA: Estado del sistema -->
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="0dp"
                    android:background="@drawable/bg_dot_ok" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="26dp">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_wifi"
                        android:contentDescription="@string/titulo_ubicacion"
                        app:tint="?attr/colorSecondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sistema activo y vigilando"
                            android:textStyle="bold"
                            android:textColor="?attr/android:textColor"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Última conexión hace 2 minutos"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- FILA: Estado de batería -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/ic_tiempo"
                        app:tint="?attr/colorSecondary"
                        android:contentDescription="@string/batería" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tiempo: Soleado"
                            android:textStyle="bold"
                            android:textColor="?attr/android:textColor"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Puedes conducir con seguridad"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
