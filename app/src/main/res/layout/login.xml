<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Título -->
        <ImageView
            android:id="@+id/imageLogo"
            android:layout_width="129dp"
            android:layout_height="94dp"
            android:layout_marginTop="50dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter"
            android:src="@drawable/logokova"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Label: correo -->
        <TextView
            android:id="@+id/textView2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:text="@string/correo"
            style="@style/TituloLabel"
            android:textColor="@color/icono_normal"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="150dp"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Campo: correo -->
        <EditText
            android:id="@+id/editTextText"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:background="@drawable/rounded_edittext_selector"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/textView2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Label: contraseña -->
        <TextView
            android:id="@+id/textView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/contrasena"
            app:layout_constraintTop_toBottomOf="@id/editTextText"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            style="@style/TituloLabel" />

        <!-- Contenedor contraseña -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/passwordContainer"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/textView3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Campo contraseña -->
            <EditText
                android:id="@+id/editTextTextPassword"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/rounded_edittext_selector"
                android:fontFamily="@font/montserrat_bold_ttf"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="48dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Icono ojo -->
            <ImageView
                android:id="@+id/imageViewTogglePassword"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="14dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_eye_closed"
                android:tint="@color/icono_normal"
                android:contentDescription="Mostrar u ocultar contraseña"
                app:layout_constraintEnd_toEndOf="@+id/editTextTextPassword"
                app:layout_constraintTop_toTopOf="@+id/editTextTextPassword"
                app:layout_constraintBottom_toBottomOf="@+id/editTextTextPassword" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Botón iniciar sesión -->
        <Button
            android:id="@+id/button"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:text="Iniciar sesión"
            app:layout_constraintTop_toBottomOf="@id/passwordContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Botón registrarse -->
        <Button
            android:id="@+id/button2"
            android:layout_width="277dp"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="#00FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:text="¿Aún no tienes cuenta? Regístrate"
            android:textColor="@color/icono_normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button" />

        <!-- Botón olvidar contraseña -->
        <Button
            android:id="@+id/button3"
            android:layout_width="247dp"
            android:layout_height="36dp"
            android:layout_marginTop="5dp"
            android:background="#00FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:text="He olvidado mi contraseña"
            android:textColor="@color/icono_normal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/button2" />

        <!-- Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button4"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Inicia sesión con Google"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:textColor="#FFFFFF"
            app:icon="@drawable/google"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:backgroundTint="#CE4343"
            app:strokeColor="#CE4343"
            app:strokeWidth="1dp"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@id/button3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- X -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button5"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:text="Inicia sesión con X"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:textColor="#FFFFFF"
            app:icon="@drawable/twitter"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="24dp"
            app:backgroundTint="#000000"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/button4"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Facebook -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button6"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/montserrat_bold_ttf"
            android:text="Inicia sesión con Facebook"
            android:textColor="#FFFFFF"
            app:backgroundTint="#1877F2"
            app:cornerRadius="24dp"
            app:icon="@drawable/facebook"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:layout_constraintTop_toBottomOf="@id/button5"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
