<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="25dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:id="@+id/titulo"
            style="@style/Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="Editar coche"
            android:textColor="@color/icono_normal"
            android:textSize="20sp" />

        <!-- Descripcion -->
        <TextView
            android:id="@+id/descripcion"
            style="@style/DescripciónActividad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:layout_marginTop="30dp"
            android:fontFamily="@font/roboto_regular"
            android:text="Edita los datos de tu coche" />

        <!-- CARD CONTENEDOR -->
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:background="@drawable/bg_card_soft"
            android:elevation="4dp"
            android:clipToPadding="false">

            <!-- Nombre -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nombre"
                android:textColor="@color/icono_normal"
                android:fontFamily="@font/roboto_regular"
                android:layout_marginBottom="5dp"/>

            <EditText
                android:id="@+id/edtNombre"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_oscuro"
                android:hint="Introduce el nombre"/>

            <!-- Marca -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Marca"
                android:layout_marginTop="15dp"
                android:textColor="@color/icono_normal"
                android:fontFamily="@font/roboto_regular"/>

            <EditText
                android:id="@+id/edtMarca"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_oscuro"
                android:hint="Introduce la marca"/>

            <!-- Modelo -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Modelo"
                android:textColor="@color/icono_normal"
                android:fontFamily="@font/roboto_regular"/>

            <EditText
                android:id="@+id/edtModelo"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_oscuro"
                android:hint="Introduce el modelo"/>

            <!-- Matrícula -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Matrícula"
                android:textColor="@color/icono_normal"
                android:fontFamily="@font/roboto_regular"/>

            <EditText
                android:id="@+id/edtMatricula"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:textColor="@color/texto_oscuro"
                android:hint="Introduce la matrícula"/>

        </LinearLayout>
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="170dp"
            android:layout_height="50dp"
            android:layout_marginTop="25dp"
            android:layout_gravity="center"
            android:fontFamily="@font/montserrat_bold"
            android:gravity="center"
            android:text="Guardar cambios"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_card_soft"/>

        <Button
            android:id="@+id/btnEliminar"
            android:layout_width="120dp"
            android:layout_height="40dp"
            android:layout_marginTop="15dp"
            android:layout_gravity="center"
            android:text="Eliminar coche"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:fontFamily="@font/montserrat_bold"
            android:background="@drawable/bg_boton_rojo"/>
    </LinearLayout>

</ScrollView>
