<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_register_wizard">

    <!-- Flecha atrás ELIMINADA: ya no existe btnBackEditar -->

    <!-- SCROLL -->
    <ScrollView
        android:id="@+id/scrollEdit"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnGuardar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="16dp"
            android:paddingBottom="80dp">

            <!-- TITULO -->
            <TextView
                android:id="@+id/tvTitleEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Editar vehículo"
                android:textSize="26sp"
                android:textColor="@color/icono_normal"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="20dp"/>

            <!-- SUBTÍTULO -->
            <TextView
                android:id="@+id/tvSubtitleEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Actualiza la información de tu coche"
                android:textSize="15sp"
                android:textColor="@color/texto_oscuro"
                android:gravity="center"
                android:layout_marginTop="6dp"/>

            <!-- CARD -->
            <LinearLayout
                android:id="@+id/cardEditar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_rounded"
                android:elevation="8dp"
                android:padding="36dp"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="24dp">

                <!-- CAMPOS -->
                <EditText
                    android:id="@+id/edtNombre"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Nombre o apodo"/>

                <EditText
                    android:id="@+id/edtMarca"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Marca"
                    android:layout_marginTop="16dp"/>

                <EditText
                    android:id="@+id/edtModelo"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Modelo"
                    android:layout_marginTop="16dp"/>

                <EditText
                    android:id="@+id/edtMatricula"
                    style="@style/EditText"
                    android:layout_width="match_parent"
                    android:layout_height="45dp"
                    android:hint="Matrícula (1234DKB)"
                    android:inputType="textCapCharacters"
                    android:layout_marginTop="16dp"/>

                <!-- BOTÓN AÑADIR FOTO -->
                <Button
                    android:id="@+id/btnCambiarFoto"
                    style="@style/BotonEditarFoto"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Añadir foto"
                    android:layout_marginTop="24dp"/>

                <!-- BOTÓN ROJO ELIMINAR -->
                <Button
                    android:id="@+id/btnEliminar"
                    style="@style/BotonEliminarRojo"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Eliminar vehículo"
                    android:layout_marginTop="20dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- BOTÓN GUARDAR -->
    <Button
        android:id="@+id/btnGuardar"
        style="@style/BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guardar cambios"
        android:padding="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
