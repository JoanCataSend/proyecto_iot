<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_claro">

    <!-- CONTENIDO PRINCIPAL -->
    <LinearLayout
        android:id="@+id/contentEditar"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btnGuardar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/tvTitleEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar vehículo"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/icono_normal"
            android:layout_marginBottom="6dp"/>

        <!-- SUBTÍTULO -->
        <TextView
            android:id="@+id/tvSubtitleEditar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Actualiza la información de tu coche"
            android:textSize="15sp"
            android:textColor="@color/texto_oscuro"
            android:layout_marginBottom="28dp"/>

        <!-- CARD -->
        <LinearLayout
            android:id="@+id/cardEditar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_rounded"
            android:elevation="8dp"
            android:padding="28dp">

            <!-- NOMBRE -->
            <EditText
                android:id="@+id/edtNombre"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:hint="Nombre o apodo"/>

            <!-- MARCA -->
            <EditText
                android:id="@+id/edtMarca"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="14dp"
                android:hint="Marca"/>

            <!-- MODELO -->
            <EditText
                android:id="@+id/edtModelo"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="14dp"
                android:hint="Modelo"/>

            <!-- MATRÍCULA -->
            <EditText
                android:id="@+id/edtMatricula"
                style="@style/EditText"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginTop="14dp"
                android:hint="Matrícula (1234DKB)"
                android:inputType="textCapCharacters"/>

            <!-- FOTO -->
            <Button
                android:id="@+id/btnCambiarFoto"
                style="@style/BotonEditarFoto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:text="Cambiar foto"/>

            <!-- ELIMINAR -->
            <Button
                android:id="@+id/btnEliminar"
                style="@style/BotonEliminarRojo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Eliminar vehículo"/>

        </LinearLayout>

    </LinearLayout>

    <!-- BOTÓN GUARDAR (FIJO ABAJO) -->
    <Button
        android:id="@+id/btnGuardar"
        style="@style/BotonPrincipal"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guardar cambios"
        android:padding="14dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
