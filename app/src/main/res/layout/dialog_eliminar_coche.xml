<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="25dp"
    android:background="@drawable/bg_dialog"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/ic_warning"
        android:tint="@color/error"
        android:layout_gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Eliminar coche"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/texto_oscuro"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/montserrat_bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="¿Seguro que quieres eliminar este coche? Esta acción no se puede deshacer."
        android:textSize="15sp"
        android:textColor="@color/texto_oscuro"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_regular"/>

    <Button
        android:id="@+id/btnEliminarDef"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Eliminar"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:layout_marginTop="25dp"
        android:background="@drawable/bg_boton_rojo"
        android:fontFamily="@font/montserrat_bold"/>

    <Button
        android:id="@+id/btnCancelar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cancelar"
        android:textAllCaps="false"
        android:textColor="@color/texto_claro"
        android:background="@drawable/bg_input"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/roboto_regular"/>

</LinearLayout>
