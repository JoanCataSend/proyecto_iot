<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    android:layout_marginHorizontal="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:foreground="?android:attr/selectableItemBackground"
    android:background="@drawable/bg_card_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        >

        <!-- Ícono del coche -->
        <ImageView
            android:id="@+id/icono_coche"
            android:layout_width="24dp"
            android:layout_height="24dp"
            app:tint="@color/fondo_oscuro"
            android:src="@drawable/ic_coche" />

        <!-- Nombre del coche -->
        <TextView
            android:id="@+id/nombre_coche"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/texto_oscuro"
            android:textSize="15sp"
            android:paddingStart="12dp" />

        <!-- Botón de opciones (3 puntitos) -->
        <ImageButton
            android:id="@+id/btnOpciones"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/tres_puntitos"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
