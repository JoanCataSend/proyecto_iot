<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Boton morado -->
    <style name="BotonPrincipal">
        <item name="android:background">@drawable/boton_principal</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Título de las páginas -->
    <style name="Seccion">
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/icono_normal</item>
    </style>

    <!-- Descripciones de las actividades -->
    <style name="DescripciónActividad">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_oscuro</item>
    </style>

    <!-- Títulos de los label (Lo que te dice que tienes que escribir) -->
    <style name="TituloLabel">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/icono_normal</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="EditText">
        <item name="android:background">@drawable/fondo_caja</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/texto_oscuro</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="DialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>

    <style name="ImagenCircular">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <!-- 🔹 Botón "Añadir foto" estilo iOS -->
    <style name="BotonEditarFoto">
        <item name="android:background">@drawable/bg_button_ios</item>
        <item name="android:textColor">@color/icono_normal</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>

        <!-- Muy importante: evitar que el tema tiña el botón de morado -->
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

    <!-- 🔹 Botón rojo para eliminar coche -->
    <style name="BotonEliminarRojo">
        <item name="android:background">@drawable/bg_boton_rojo_moderno</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@font/montserrat_bold</item>
        <item name="android:gravity">center</item>

        <!-- Igual: anulamos el tint morado del tema -->
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
    </style>

</resources>
