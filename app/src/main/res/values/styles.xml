<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Boton morado -->
    <style name="BotonPrincipal">
        <item name="android:background">@drawable/boton_principal</item>
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>

    </style>

    <!-- Título de las páginas -->
    <style name="Seccion">
        <item name="fontFamily">@font/montserrat_bold</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/icono_normal</item>
    </style>

    <!-- Descripciones de las actividades -->
    <style name="DescripciónActividad">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/texto_oscuro</item>
    </style>

    <!-- Títulos de los label (Lo que te dice que tienes que escribir) -->
    <style name="TituloLabel">
        <item name="fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/icono_normal</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="EditText">
        <item name="android:background">@drawable/fondo_caja</item> <!-- caja -->
        <item name="android:paddingStart">10dp</item>               <!-- espacio a la izquierda -->
        <item name="android:paddingEnd">10dp</item>                 <!-- espacio a la derecha -->
        <item name="android:paddingTop">8dp</item>                  <!-- espacio arriba -->
        <item name="android:paddingBottom">8dp</item>               <!-- espacio abajo -->
        <item name="android:fontFamily">@font/roboto_regular</item>
        <item name="android:textColor">@color/texto_oscuro</item>
        <item name="android:textSize">15sp</item>
    </style>
    <style name="DialogStyle" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
    </style>
</resources>