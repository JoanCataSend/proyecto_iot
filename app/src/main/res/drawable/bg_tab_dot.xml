<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- seleccionado -->
    <item android:state_selected="true">
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="@color/icono_normal" />
        </shape>
    </item>

    <!-- normal -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="8dp"
                android:height="8dp" />
            <solid android:color="@color/morado_claro" />
        </shape>
    </item>

</selector>

