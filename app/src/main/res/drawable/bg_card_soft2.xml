<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
        </shape>
    </item>

    <!-- Capa principal -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="15dp" />
            <solid android:color="#FFFFFFFF" /> <!-- blanco puro -->
            <stroke
                android:width="0.5dp"
                android:color="#33000000" /> <!-- borde gris claro -->
        </shape>
    </item>

</layer-list>
